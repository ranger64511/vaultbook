{
  "name": "vaultbook",
  "version": "1.0.0",
  "private": true,
  "description": "Private, self-hosted personal finance tracker. Import bank & credit card statements (CSV, OFX/QFX, PDF), see spending by month and week, spot recurring charges to cancel, budget by needs vs. wants, and plan your credit card payoff. React + Node, AES-256 encrypted, runs only on your computer.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "personal-finance",
    "budget",
    "debt-payoff",
    "self-hosted",
    "react",
    "encryption"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"node --watch-path=server server/index.js\" \"vite\"",
    "dev:demo": "concurrently -k -n api,web -c blue,magenta \"node --watch-path=server server/index.js --demo\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js --prod",
    "samples": "node samples/generate.js",
    "test": "node --test server/categorize.test.js client/src/lib/analytics.test.js client/src/lib/accounts.test.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "vite": "^8.3.2"
  }
}
